# Leetcode #9
# Palindrome Number
class Solution:
    def isPalindrome(self, x: int) -> bool:
        num,l=x,0
        while num>0:
            m=num%10
            l=(l*10)+m
            num=num//10
        return l==x

#507 Perfect Number
class Solution:
    def checkPerfectNumber(self, num: int) -> bool:
        n=0
        for i in range(1,int(num**(1/2))+1):
            if num%i == 0 :
                if num//i==i:
                    n+=i
                else:
                    n=n+i+(num/i)
        return n-num==num    

